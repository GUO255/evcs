# ================= 测试环境 (test) =================
# 复制为 .env.test 并填写真实值（.env.* 不入库）
ENV_NAME=test

# ---- 共享 MySQL（分库 evcs_test）----
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=evcs
MYSQL_PASSWORD=CHANGE_ME_TEST
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_TEST
MYSQL_DATABASE=evcs_test

# ---- 主机暴露端口 ----
WEB_PORT=8082
PLATFORM_PORT=3230
CHARGING_PORT=3241

# ---- 前端编译期变量（PUBLIC_*）----
PUBLIC_TIANDITU_TOKEN=
PUBLIC_AMAP_KEY=
PUBLIC_AMAP_SECURITY_JS_CODE=

# ---- 应用运行变量 ----
AUTH_PLATFORM_WEB_ORIGIN=http://localhost:8082

# ---- 数据库迁移 ----
# EVCS_MIGRATION_SCOPE=all