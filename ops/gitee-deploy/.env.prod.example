# ================= 生产环境 (prod) =================
# 复制为 .env.prod 并填写真实值（.env.* 不入库）
ENV_NAME=prod

# ---- 共享 MySQL（分库 evcs_prod）----
# MYSQL_HOST 指外部共享实例时，注释掉 compose.yaml 里的 mysql 服务即可
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=evcs
MYSQL_PASSWORD=CHANGE_ME_PROD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PROD
MYSQL_DATABASE=evcs_prod

# ---- 主机暴露端口（生产：80）----
WEB_PORT=80
PLATFORM_PORT=3230
CHARGING_PORT=3241

# ---- 前端编译期变量（PUBLIC_* 生产必填）----
PUBLIC_TIANDITU_TOKEN=
PUBLIC_AMAP_KEY=
PUBLIC_AMAP_SECURITY_JS_CODE=

# ---- 应用运行变量（生产域名）----
AUTH_PLATFORM_WEB_ORIGIN=https://your-domain.example.com

# ---- 数据库迁移 ----
# EVCS_MIGRATION_SCOPE=all